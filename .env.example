# ─────────────────────────────────────────────────────────────────────────────
# Camp Simcha Dougies — Environment Variables
#
# Copy this file to `.env.local` for local development and fill in real values.
# In production (e.g. Vercel), set these in your project's Environment Variables.
# NEVER commit real secrets — `.env*` files are gitignored.
# ─────────────────────────────────────────────────────────────────────────────

# ── Email (Resend) ───────────────────────────────────────────────────────────
# Required to send order confirmations, admin notifications, and the daily
# summary. Create a key at https://resend.com/api-keys
RESEND_API_KEY=re_your_api_key_here

# Verified "from" address. The domain must be verified in your Resend account.
EMAIL_FROM=dougies@abbrachfeld.com

# Comma-separated list of admins who receive new-order and daily-summary emails.
ADMIN_EMAILS=abbrachfeld@gmail.com,kobygryfe@gmail.com

# Shared secret protecting the /api/send-daily-summary endpoint. Vercel Cron
# sends this automatically as `Authorization: Bearer <CRON_SECRET>`.
# Generate one with:  openssl rand -hex 32
CRON_SECRET=generate_a_long_random_string

# ── Firebase (client SDK — safe to expose, but configurable per environment) ──
NEXT_PUBLIC_FIREBASE_API_KEY=AIzaSyBDtrJSzqnI6GWVhGKkieqq0EwUBnqmDIA
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=dougies-7356f.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=dougies-7356f
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=dougies-7356f.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=807239650263
NEXT_PUBLIC_FIREBASE_APP_ID=1:807239650263:web:86e66d8c93e235a8685992
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=G-X549VDX723
